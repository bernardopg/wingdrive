{
	// Use IntelliSense to learn about possible attributes.
	// Hover to view descriptions of existing attributes.
	// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
	"version": "0.2.0",
	"configurations": [
		{
			"type": "lldb",
			"request": "launch",
			"name": "Tauri Development Debug",
			"cargo": {
				"args": [
					"build",
					"--profile=dev-debug",
					"--manifest-path=./apps/desktop/src-tauri/Cargo.toml",
					"--no-default-features"
				],
				"problemMatcher": "$rustc"
			},
			"env": {
				"RUST_BACKTRACE": "short"
			},
			"sourceLanguages": [
				"rust"
			],
			"preLaunchTask": "ui:dev"
		},
		{
			"type": "lldb",
			"request": "launch",
			"name": "Tauri Production Debug",
			"cargo": {
				"args": [
					"build",
					"--release",
					"--manifest-path=./apps/desktop/src-tauri/Cargo.toml"
				],
				"problemMatcher": "$rustc"
			},
			"sourceLanguages": [
				"rust"
			],
			"preLaunchTask": "ui:build"
		},
		{
			"type": "lldb",
			"request": "launch",
			"name": "Debug unit tests in library 'wing-core'",
			"cargo": {
				"args": [
					"test",
					"--no-run",
					"--lib",
					"--package=wing-core"
				],
				"filter": {
					"name": "wing-core",
					"kind": "lib"
				}
			},
			"args": [],
			"cwd": "${workspaceFolder}"
		},
		{
			"type": "lldb",
			"request": "launch",
			"name": "Debug unit tests in library 'wing-crypto'",
			"cargo": {
				"args": [
					"test",
					"--no-run",
					"--lib",
					"--package=wing-crypto"
				],
				"filter": {
					"name": "wing-crypto",
					"kind": "lib"
				}
			},
			"args": [],
			"cwd": "${workspaceFolder}"
		},
		{
			"type": "swift",
			"request": "launch",
			"args": [],
			"cwd": "${workspaceFolder:wingdrive}/apps/wingdrive-companion",
			"name": "Debug WingDriveCompanion (apps/wingdrive-companion)",
			"program": "${workspaceFolder:wingdrive}/apps/wingdrive-companion/.build/debug/WingDriveCompanion",
			"preLaunchTask": "swift: Build Debug WingDriveCompanion (apps/wingdrive-companion)"
		},
		{
			"type": "swift",
			"request": "launch",
			"args": [],
			"cwd": "${workspaceFolder:wingdrive}/apps/wingdrive-companion",
			"name": "Release WingDriveCompanion (apps/wingdrive-companion)",
			"program": "${workspaceFolder:wingdrive}/apps/wingdrive-companion/.build/release/WingDriveCompanion",
			"preLaunchTask": "swift: Build Release WingDriveCompanion (apps/wingdrive-companion)"
		},
		{
			"type": "swift",
			"request": "launch",
			"args": [],
			"cwd": "${workspaceFolder:wingdrive}/packages/rust-swift/swift-ui",
			"name": "Debug SwiftUIDemo (packages/rust-swift/swift-ui)",
			"program": "${workspaceFolder:wingdrive}/packages/rust-swift/swift-ui/.build/debug/SwiftUIDemo",
			"preLaunchTask": "swift: Build Debug SwiftUIDemo (packages/rust-swift/swift-ui)"
		},
		{
			"type": "swift",
			"request": "launch",
			"args": [],
			"cwd": "${workspaceFolder:wingdrive}/packages/rust-swift/swift-ui",
			"name": "Release SwiftUIDemo (packages/rust-swift/swift-ui)",
			"program": "${workspaceFolder:wingdrive}/packages/rust-swift/swift-ui/.build/release/SwiftUIDemo",
			"preLaunchTask": "swift: Build Release SwiftUIDemo (packages/rust-swift/swift-ui)"
		},
		{
			"type": "swift",
			"request": "launch",
			"args": [],
			"cwd": "${workspaceFolder:wingdrive}/apps/macos",
			"name": "Debug WingDrive (apps/macos)",
			"program": "${workspaceFolder:wingdrive}/apps/macos/.build/debug/WingDrive",
			"preLaunchTask": "swift: Build Debug WingDrive (apps/macos)"
		},
		{
			"type": "swift",
			"request": "launch",
			"args": [],
			"cwd": "${workspaceFolder:wingdrive}/apps/macos",
			"name": "Release WingDrive (apps/macos)",
			"program": "${workspaceFolder:wingdrive}/apps/macos/.build/release/WingDrive",
			"preLaunchTask": "swift: Build Release WingDrive (apps/macos)"
		}
	]
}
