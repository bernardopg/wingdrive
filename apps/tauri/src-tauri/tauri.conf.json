{
  "productName": "WingDrive",
  "version": "2.0.0-alpha.10",
  "identifier": "com.wingdrive.desktop",
  "plugins": {
    "updater": {
      "endpoints": [],
      "pubkey": ""
    }
  },
  "build": {
    "beforeDevCommand": "bun run dev:with-daemon",
    "beforeBuildCommand": "bun run build:daemon:release && bun run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "WingDrive",
        "width": 1400,
        "height": 750,
        "minWidth": 768,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false,
        "hiddenTitle": true,
        "transparent": true,
        "center": true,
        "visible": false,
        "dragDropEnabled": true,
        "decorations": true,
        "windowEffects": {
          "effects": [
            "sidebar"
          ],
          "state": "followsWindowActiveState",
          "radius": 9
        }
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:*",
        "img-src": "'self' asset: http://asset.localhost http://127.0.0.1:* http://localhost:* blob: data:",
        "media-src": "'self' asset: http://asset.localhost http://127.0.0.1:* http://localhost:* blob: data:",
        "style-src": "'self' 'unsafe-inline'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**",
          "/Volumes/**",
          "/media/**",
          "/mnt/**",
          "/run/media/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "WingDrive contributors",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "../../../target/release/wing-daemon"
    ],
    "resources": {
      "gen/**/*": "./",
      "../../../LICENSE": "./LICENSE",
      "../../../NOTICE.md": "./NOTICE.md",
      "../../../packaging/licenses/": "./licenses/"
    },
    "fileAssociations": [
      {
        "ext": [
          "memory"
        ],
        "name": "WingDrive Memory",
        "description": "WingDrive Memory File",
        "role": "Editor",
        "mimeType": "application/x-wingdrive-memory"
      }
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "wingdrive.desktop",
        "depends": [
          "libc6",
          "libxdo3",
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0", "libheif1",
          "libayatana-appindicator3-1"
        ],
        "files": {
          "/usr/lib/wingdrive/": "../../.deps/lib/"
        }
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.plist",
      "frameworks": [
        "../../.deps/WingDrive.framework"
      ]
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      }
    }
  }
}
