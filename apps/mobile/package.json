		"eslint": "^10.13.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"lightningcss": "1.30.1",
		"postcss": "^8.5.31",
		"prettier": "^3.9.10",
		"react-native-svg-transformer": "^1.5.3",
		"tailwindcss": "^4.3.3",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.72.0"
	}
}
