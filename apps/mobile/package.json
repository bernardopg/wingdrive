{
	"name": "@wingdrive/mobile",
	"version": "0.1.0",
	"private": true,
	"main": "expo-router/entry",
	"scripts": {
		"start": "bunx expo start",
		"android": "bunx expo run:android",
		"ios": "bunx expo run:ios",
		"patch": "./scripts/patch-svg.sh",
		"prebuild": "bun run patch && bunx expo prebuild",
		"prebuild:clean": "bun run patch && bunx expo prebuild --clean",
		"xcode": "open ios/WingDrive.xcworkspace",
		"android-studio": "open -a '/Applications/Android Studio.app' ./android",
		"data": "open \"$(xcrun simctl get_app_container booted com.wingdrive.app data)\"",
		"lint": "eslint src --cache",
		"typecheck": "tsc -b"
	},
	"dependencies": {
		"@callstack/liquid-glass": "^0.8.2",
		"@dev-plugins/react-query": "^0.4.0",
		"@gorhom/bottom-sheet": "^5.2.14",
		"@react-native-async-storage/async-storage": "^3.1.1",
		"@react-native-clipboard/clipboard": "^1.16.3",
		"@react-native-community/slider": "5.2.1",
		"@react-navigation/bottom-tabs": "^7.20.0",
		"@react-navigation/drawer": "^7.14.3",
		"@react-navigation/native": "^7.5.0",
		"@react-navigation/native-stack": "^7.20.0",
		"@wingdrive/assets": "workspace:*",
		"@wingdrive/ts-client": "workspace:*",
		"@shopify/flash-list": "2.0.2",
		"@wingdrive/tokens": "^0.2.3",
		"@tanstack/react-query": "^5.104.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"expo": "~57.0.27",
		"expo-asset": "~57.0.19",
		"expo-blur": "~57.0.3",
		"expo-build-properties": "~57.0.22",
		"expo-camera": "~57.0.6",
		"expo-constants": "~57.0.21",
		"expo-dev-client": "~57.0.19",
		"expo-document-picker": "~57.0.3",
		"expo-file-system": "~57.0.7",
		"expo-haptics": "~57.0.3",
		"expo-image": "~57.0.5",
		"expo-linking": "~57.0.12",
		"expo-modules-core": "~3.0.30",
		"expo-router": "~57.0.25",
		"expo-splash-screen": "~57.0.9",
		"expo-status-bar": "~57.0.1",
		"nativewind": "^4.2.7",
		"phosphor-react-native": "^3.0.6",
		"react": "19.3.0",
		"react-native": "0.87.1",
		"react-native-gesture-handler": "~3.3.0",
		"react-native-qrcode-svg": "^6.3.26",
		"react-native-reanimated": "4.6.0",
		"react-native-safe-area-context": "~5.10.1",
		"react-native-screens": "~4.28.0",
		"react-native-svg": "15.15.5",
		"react-native-worklets": "0.13.0",
		"wing-mobile-core": "file:./modules/wing-mobile-core",
		"zustand": "^5.0.15"
	},
	"devDependencies": {
		"@babel/core": "^8.0.7",
		"@babel/plugin-transform-runtime": "^8.0.6",
		"@babel/runtime": "^8.0.7",
		"babel-preset-expo": "~58.0.11",
		"eslint": "^9.39.5",
		"prettier": "^3.9.9",
		"react-native-svg-transformer": "^1.5.3",
		"tailwindcss": "^3.4.19",
		"typescript": "~6.0.3"
