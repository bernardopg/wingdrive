		"eslint": "^10.15.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"lightningcss": "1.30.1",
		"postcss": "^8.5.33",
		"prettier": "^3.10.1",
		"react-native-svg-transformer": "^1.5.3",
		"tailwindcss": "^4.3.5",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.74.0"
	}
}
