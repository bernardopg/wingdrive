{
	"name": "@wingdrive/mobile",
	"version": "3.8.2",
	"private": true,
	"main": "expo-router/entry",
	"scripts": {
		"start": "bunx expo start",
		"android": "bunx expo run:android",
		"ios": "bunx expo run:ios",
		"patch": "./scripts/patch-svg.sh",
		"prebuild": "bun run patch && bunx expo prebuild",
		"prebuild:clean": "bun run patch && bunx expo prebuild --clean",
		"xcode": "open ios/WingDrive.xcworkspace",
		"android-studio": "open -a '/Applications/Android Studio.app' ./android",
		"data": "open \"$(xcrun simctl get_app_container booted com.wingdrive.app data)\"",
		"lint": "eslint src --max-warnings 0",
		"check:i18n": "bun scripts/check-i18n.ts",
		"typecheck": "tsc -b"
	},
	"dependencies": {
		"@callstack/liquid-glass": "^0.8.2",
		"@dev-plugins/react-query": "^0.4.0",
		"@gorhom/bottom-sheet": "^5.2.14",
		"@react-native-async-storage/async-storage": "2.2.0",
		"@react-native-clipboard/clipboard": "^1.17.1",
		"@react-native-community/slider": "5.2.1",
		"@react-navigation/bottom-tabs": "^7.22.0",
		"@react-navigation/drawer": "^7.14.5",
		"@react-navigation/native": "^7.5.2",
		"@react-navigation/native-stack": "^7.21.1",
		"@shopify/flash-list": "2.3.2",
		"@tanstack/react-query": "^5.108.4",
		"@wingdrive/assets": "workspace:*",
		"@wingdrive/tokens": "^0.2.3",
		"@wingdrive/ts-client": "workspace:*",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"expo": "~58.0.26",
		"expo-asset": "~58.0.21",
		"expo-blur": "~58.0.6",
		"expo-build-properties": "~58.0.12",
		"expo-camera": "~58.0.14",
		"expo-constants": "~58.0.13",
		"expo-dev-client": "~58.0.21",
		"expo-document-picker": "~58.0.5",
		"expo-file-system": "~58.0.14",
		"expo-haptics": "~58.0.8",
		"expo-image": "~58.0.18",
		"expo-linking": "~58.0.17",
		"expo-router": "~58.0.32",
		"expo-splash-screen": "~58.0.14",
		"expo-status-bar": "~58.0.4",
		"expo-symbols": "~58.0.5",
		"i18next": "^27.2.9",
		"nativewind": "5.0.0-rc.1",
		"phosphor-react-native": "^3.0.6",
		"react": "19.3.0",
		"react-i18next": "^18.0.1",
		"react-native": "0.88.1",
		"react-native-css": "3.1.0-rc.1",
		"react-native-gesture-handler": "~3.3.0",
		"react-native-qrcode-svg": "^6.3.54",
		"react-native-reanimated": "4.7.1",
		"react-native-safe-area-context": "~5.11.1",
		"react-native-screens": "~4.30.1",
		"react-native-svg": "15.16.0",
		"react-native-worklets": "0.13.0",
		"wing-mobile-core": "file:./modules/wing-mobile-core",
		"zustand": "^5.1.0"
	},
	"devDependencies": {
		"@babel/core": "^7.29.13",
		"@babel/plugin-transform-runtime": "^7.29.7",
