{
  "expo": {
    "name": "WingDrive",
    "slug": "wingdrive",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "wingdrive",
    "platforms": [
      "ios",
      "android"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "bundleIdentifier": "com.wingdrive.app",
      "supportsTablet": true,
      "deploymentTarget": "18.0"
    },
    "android": {
      "package": "com.wingdrive.app",
      "adaptiveIcon": {
        "backgroundColor": "#000000"
      },
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "18.0"
          },
          "android": {
            "minSdkVersion": 24,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "kotlinVersion": "2.2.20"
          }
        }
      ],
      "expo-asset",
      "expo-router",
      "expo-splash-screen"
    ]
  }
}
