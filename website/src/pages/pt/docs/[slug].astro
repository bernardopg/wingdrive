---
import Doc from "../../../views/Doc.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
	const docs = await getCollection("docs", (d) => d.id.startsWith("pt/"));
	return docs.map((entry) => ({ params: { slug: entry.id.replace("pt/", "") }, props: { entry } }));
}
const { entry } = Astro.props;
---

<Doc lang="pt" entry={entry} />
