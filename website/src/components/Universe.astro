---
import { t, type Lang } from "../i18n/strings";

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const s = t[lang].universe;
const labels = [s.labels.ssd, s.labels.hdd, s.labels.usb, s.labels.nas, `${s.labels.cloud} · S3`, `${s.labels.cloud} · Drive`];
---

<section class="section universe" id="library">
	<div class="glow-orb" style="width:600px;height:600px;left:-200px;top:10%;background:#4338ca"></div>
	<div class="wrap layout">
		<div class="copy">
			<span class="eyebrow reveal">{s.eyebrow}</span>
			<h2 class="h-lg reveal" style="--d:60ms">{s.title}</h2>
			<p class="lead reveal" style="--d:120ms">{s.lead}</p>
			<dl class="stats">
				{
					s.stats.map((st, i) => (
						<div class="reveal" style={`--d:${180 + i * 80}ms`}>
							<dt class="grad">{st.k}</dt>
							<dd>{st.v}</dd>
						</div>
					))
				}
			</dl>
		</div>
		<div class="stage reveal" data-universe style="--d:100ms">
			<canvas aria-label={s.title} role="img"></canvas>
			{labels.map((l, i) => <span class="tag" data-label={i}>{l}</span>)}
			<img class="fallback" src="/img/art/cloud-640.webp" alt="" loading="lazy" />
		</div>
	</div>
</section>

<script>
	const root = document.querySelector<HTMLElement>("[data-universe]");
	if (root) {
		const io = new IntersectionObserver(
			async ([e]) => {
				if (!e.isIntersecting) return;
				io.disconnect();
				const { mountUniverse } = await import("../scripts/universe");
				mountUniverse(root);
			},
			{ rootMargin: "400px" },
		);
		io.observe(root);
	}
</script>

<style>
	.universe {
		overflow: hidden;
	}
	.layout {
		display: grid;
		grid-template-columns: 0.9fr 1.1fr;
		gap: 40px;
		align-items: center;
	}
	.copy {
		display: grid;
		gap: 20px;
	}
	.stats {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 18px;
		margin: 18px 0 0;
	}
	.stats div {
		border-top: 1px solid var(--line-strong);
		padding-top: 14px;
	}
	dt {
		font-family: var(--display);
		font-size: clamp(28px, 3.4vw, 40px);
		font-weight: 700;
		letter-spacing: -0.03em;
	}
	dd {
		margin: 4px 0 0;
		color: var(--muted);
		font-size: 14px;
		line-height: 1.45;
	}
	.stage {
		position: relative;
		overflow: hidden;
		aspect-ratio: 1 / 0.9;
		cursor: grab;
		touch-action: pan-y;
	}
	.stage.grabbing {
		cursor: grabbing;
	}
	.stage::before {
		content: "";
		position: absolute;
		inset: 12%;
		border-radius: 50%;
		background: radial-gradient(circle, rgb(124 58 237 / 0.28), transparent 65%);
		filter: blur(20px);
	}
	canvas {
		position: relative;
		width: 100%;
		height: 100%;
	}
	.tag {
		position: absolute;
		left: 0;
		top: 0;
		pointer-events: none;
		white-space: nowrap;
		font-family: var(--mono);
		font-size: 11.5px;
		letter-spacing: 0.04em;
		color: var(--lavender);
		padding: 4px 9px;
		border-radius: 999px;
		background: rgb(20 13 41 / 0.75);
		border: 1px solid var(--line);
		backdrop-filter: blur(6px);
		transition: opacity 0.3s;
		opacity: 0;
		will-change: transform;
	}
	.fallback {
		display: none;
	}
	:global(.no-webgl) canvas,
	:global(.no-webgl) .tag {
		display: none;
	}
	:global(.no-webgl) .fallback {
		display: block;
		border-radius: var(--radius);
		width: 100%;
	}
	@media (max-width: 900px) {
		.layout {
			grid-template-columns: 1fr;
		}
		.stats {
			grid-template-columns: 1fr 1fr 1fr;
			gap: 12px;
		}
		.stage {
			aspect-ratio: 1 / 0.7;
		}
	}
	@media (max-width: 640px) {
		/* Six labels crowd a phone-sized scene; the copy above already names every drive. */
		.tag {
			display: none;
		}
	}
</style>
