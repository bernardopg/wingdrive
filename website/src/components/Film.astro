---
import Icon from "./Icon.astro";
import { t, type Lang } from "../i18n/strings";

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const s = t[lang].film;
---

<section class="section film" id="film">
	<div class="wrap">
		<div class="section-head center">
			<span class="eyebrow reveal">{s.eyebrow}</span>
			<h2 class="h-lg reveal" style="--d:60ms">{s.title}</h2>
		</div>
		<div class="frame reveal" style="--d:100ms">
			<video controls playsinline preload="none" poster="/video/wingdrive-film-poster.webp" width="1920" height="1080">
				<source src="/video/wingdrive-film.webm" type="video/webm" />
				<source src="/video/wingdrive-film.mp4" type="video/mp4" />
			</video>
		</div>
		<div class="more reveal" style="--d:140ms">
			<a href="/video/wingdrive-tour.mp4"><Icon name="arrow" size={15} />{s.full} · 1:39</a>
			<a href="/video/wingdrive-shorts.mp4"><Icon name="arrow" size={15} />{s.shorts} · 9:16</a>
		</div>
	</div>
</section>

<style>
	.frame {
		max-width: 1100px;
		margin: 0 auto;
		border-radius: 22px;
		overflow: hidden;
		border: 1px solid var(--line);
		background: #05040b;
		box-shadow:
			0 40px 120px rgb(0 0 0 / 0.6),
			0 10px 60px rgb(76 29 149 / 0.25);
	}
	video {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 16 / 9;
	}
	.more {
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		gap: 28px;
		margin-top: 22px;
	}
	.more a {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		color: var(--muted, #a19fb8);
		text-decoration: none;
		font-size: 15px;
	}
	.more a:hover {
		color: var(--text);
	}
</style>
