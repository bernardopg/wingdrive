---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import CopyCode from "../components/CopyCode.astro";
import { t, type Lang, RELEASES, AUR, DOCKER } from "../i18n/strings";
import { latestRelease, pick, fmtSize } from "../i18n/release";

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const s = t[lang].download;
const r = await latestRelease();
const appimage = pick(r, /x86_64\.AppImage$/);
const deb = pick(r, /amd64\.deb$/);
const exe = pick(r, /setup\.exe$/);
const msi = pick(r, /\.msi$/);
const apk = pick(r, /arm64-v8a\.apk$/);
const date = new Date(r.date).toLocaleDateString(lang === "pt" ? "pt-BR" : "en-US", { year: "numeric", month: "long", day: "numeric" });
const notesUrl = `${RELEASES}/tag/${r.tag}`;
---

<Base lang={lang} title={s.title} description={s.lead}>
	<section class="head">
		<div class="glow-orb" style="width:700px;height:500px;left:50%;top:-200px;margin-left:-350px;background:#6d28d9"></div>
		<div class="wrap">
			<span class="eyebrow">{s.latest}</span>
			<h1 class="h-lg">{s.title}</h1>
			<p class="lead">{s.lead}</p>
			<div class="ver">
				<span class="pill"><span class="dot"></span>WingDrive {r.version}</span>
				<span>{s.published} {date}</span>
				<a href={notesUrl} rel="noopener">{s.notes} <Icon name="external" size={14} /></a>
				<a href={RELEASES} rel="noopener">{s.all} <Icon name="external" size={14} /></a>
			</div>
		</div>
	</section>

	<section class="wrap grid" data-downloads>
		<article class="card plat" data-os="linux">
			<span class="rec">{s.recommended}</span>
			<header><Icon name="tux" size={30} /><div><h2>{s.linux.t}</h2><span class="pill"><span class="dot"></span>{s.linux.s}</span></div></header>
			<p>{s.linux.d}</p>
			<div class="btns">
				{appimage && <a class="btn btn-primary" href={appimage.url}><Icon name="download" size={17} />AppImage <small>{fmtSize(appimage.size)}</small></a>}
				{deb && <a class="btn" href={deb.url}><Icon name="download" size={17} />.deb <small>{fmtSize(deb.size)}</small></a>}
			</div>
			<h3>{s.linux.aurT}</h3>
			<p class="small">{s.linux.aurD}</p>
			<CopyCode code="yay -S wingdrive-bin" />
			<a class="link" href={AUR} rel="noopener">aur.archlinux.org/packages/wingdrive-bin <Icon name="external" size={13} /></a>
		</article>

		<article class="card plat" data-os="windows">
			<span class="rec">{s.recommended}</span>
			<header><Icon name="windows" size={28} /><div><h2>{s.windows.t}</h2><span class="pill"><span class="dot warn"></span>{s.windows.s}</span></div></header>
			<p>{s.windows.d}</p>
			<div class="btns">
				{exe && <a class="btn btn-primary" href={exe.url}><Icon name="download" size={17} />Installer .exe <small>{fmtSize(exe.size)}</small></a>}
				{msi && <a class="btn" href={msi.url}><Icon name="download" size={17} />.msi <small>{fmtSize(msi.size)}</small></a>}
			</div>
		</article>

		<article class="card plat" data-os="mac">
			<span class="rec">{s.recommended}</span>
			<header><Icon name="apple" size={28} /><div><h2>{s.mac.t}</h2><span class="pill"><span class="dot dim"></span>{s.mac.s}</span></div></header>
			<p>{s.mac.d}</p>
			<CopyCode code={"git clone https://github.com/bernardopg/wingdrive\ncd wingdrive && just setup && just dev-desktop"} />
		</article>

		<article class="card plat" data-os="android">
			<span class="rec">{s.recommended}</span>
			<header><Icon name="android" size={28} /><div><h2>{s.android.t}</h2><span class="pill"><span class="dot dim"></span>{s.android.s}</span></div></header>
			<p>{s.android.d}</p>
			<div class="btns">
				{apk && <a class="btn" href={apk.url}><Icon name="download" size={17} />APK <small>{fmtSize(apk.size)}</small></a>}
			</div>
		</article>

		<article class="card plat wide">
			<header><Icon name="docker" size={28} /><div><h2>{s.server.t}</h2><span class="pill"><span class="dot"></span>{s.server.s}</span></div></header>
			<p>{s.server.d}</p>
			<CopyCode code={`docker run -d --name wingdrive \\\n  -p 8080:8080 -p 7373:7373 \\\n  -v wingdrive-data:/data \\\n  -e WING_AUTH=admin:change-me \\\n  ${DOCKER}:latest`} />
		</article>

		<article class="card plat wide">
			<header><Icon name="code" size={28} /><div><h2>{s.source.t}</h2></div></header>
			<p>{s.source.d}</p>
			<CopyCode code={"git clone https://github.com/bernardopg/wingdrive\ncd wingdrive\njust setup        # native deps + cargo config\njust dev-desktop  # desktop app, starts the daemon"} />
		</article>
	</section>

	<section class="wrap verify">
		<div class="card">
			<h2 class="h-md"><Icon name="shield" size={24} /> {s.verify}</h2>
			<p>{s.verifyLead}</p>
			<CopyCode code={`sha256sum -c SHA256SUMS --ignore-missing\n# Windows (PowerShell)\nGet-FileHash .\\WingDrive-${r.version}-x64-setup.exe -Algorithm SHA256`} />
			<p class="small">{s.after}</p>
		</div>
	</section>
</Base>

<script>
	// Float the visitor's platform to the top and badge it.
	const ua = navigator.userAgent;
	const os = /Android/i.test(ua) ? "android" : /Windows/i.test(ua) ? "windows" : /Mac OS X|Macintosh/i.test(ua) ? "mac" : /Linux|X11/i.test(ua) ? "linux" : null;
	const grid = document.querySelector("[data-downloads]");
	const card = os && grid?.querySelector<HTMLElement>(`[data-os="${os}"]`);
	if (grid && card) {
		card.classList.add("is-rec");
		grid.prepend(card);
	}
</script>

<style>
	.head {
		position: relative;
		padding: 150px 0 50px;
		overflow: hidden;
		text-align: center;
	}
	.head .wrap {
		display: grid;
		justify-items: center;
		gap: 18px;
	}
	.ver {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: center;
		gap: 10px 20px;
		color: var(--muted);
		font-size: 14.5px;
	}
	.ver a {
		display: inline-flex;
		align-items: center;
		gap: 5px;
		color: var(--lavender);
	}
	.grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 16px;
	}
	.plat {
		display: grid;
		align-content: start;
		gap: 14px;
	}
	.plat.is-rec {
		border-color: var(--lavender);
		box-shadow: var(--glow);
	}
	.rec {
		display: none;
		position: absolute;
		top: 18px;
		right: 18px;
		font-size: 12px;
		font-family: var(--mono);
		color: var(--lavender);
	}
	.is-rec .rec {
		display: block;
	}
	header {
		display: flex;
		gap: 14px;
		align-items: center;
		color: var(--lavender);
	}
	header div {
		display: grid;
		gap: 4px;
		justify-items: start;
	}
	h2 {
		font-size: 22px;
		color: var(--text);
	}
	header .pill {
		font-size: 12px;
		padding: 3px 9px;
	}
	h3 {
		font-size: 16px;
		margin-top: 8px;
	}
	.plat p {
		color: var(--muted);
		font-size: 15px;
	}
	.small {
		font-size: 14px !important;
		color: var(--muted);
	}
	.btns {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
	}
	.btn small {
		font-weight: 400;
		opacity: 0.7;
		font-size: 12.5px;
	}
	.link {
		display: inline-flex;
		align-items: center;
		gap: 5px;
		font-size: 13.5px;
		color: var(--lavender);
	}
	.wide {
		grid-column: span 1;
	}
	.verify {
		margin-top: 16px;
		margin-bottom: 60px;
	}
	.verify .card {
		display: grid;
		gap: 14px;
	}
	.verify h2 {
		display: flex;
		align-items: center;
		gap: 10px;
		font-size: 24px;
	}
	.verify p {
		color: var(--muted);
	}
	@media (max-width: 820px) {
		.grid {
			grid-template-columns: 1fr;
		}
	}
</style>
