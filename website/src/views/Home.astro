---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Universe from "../components/Universe.astro";
import Features from "../components/Features.astro";
import Showcase from "../components/Showcase.astro";
import Why from "../components/Why.astro";
import Sync from "../components/Sync.astro";
import Cloud from "../components/Cloud.astro";
import Arch from "../components/Arch.astro";
import Platforms from "../components/Platforms.astro";
import Cta from "../components/Cta.astro";
import type { Lang } from "../i18n/strings";

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
---

<Base lang={lang}>
	<link slot="head" rel="preload" as="image" type="image/avif" href="/img/art/hero-1920.avif" imagesrcset="/img/art/hero-1280.avif 1280w, /img/art/hero-1920.avif 1672w" imagesizes="100vw" />
	<Hero lang={lang} />
	<Universe lang={lang} />
	<Showcase lang={lang} />
	<Features lang={lang} />
	<Why lang={lang} />
	<Sync lang={lang} />
	<Cloud lang={lang} />
	<Arch lang={lang} />
	<Platforms lang={lang} />
	<Cta lang={lang} />
</Base>
