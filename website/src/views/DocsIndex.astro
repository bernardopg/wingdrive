---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { getCollection } from "astro:content";
import { t, href, type Lang, REPO } from "../i18n/strings";

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const s = t[lang].docs;
const all = (await getCollection("docs", (d) => d.id.startsWith(`${lang}/`))).sort((a, b) => a.data.order - b.data.order);
const groups = [...new Set(all.map((d) => d.data.group))].map((g) => ({ g, items: all.filter((d) => d.data.group === g) }));
const icons = ["sparkle", "download", "check", "views", "copy", "globe", "server", "tux", "terminal", "server", "code", "chat"];
---

<Base lang={lang} title={s.title} description={s.lead}>
	<section class="head">
		<div class="glow-orb" style="width:640px;height:440px;right:-140px;top:-160px;background:#6d28d9"></div>
		<div class="wrap">
			<span class="eyebrow">WingDrive</span>
			<h1 class="h-lg">{s.title}</h1>
			<p class="lead">{s.lead}</p>
		</div>
	</section>
	<section class="wrap body">
		<div class="start">
			<h2>{s.quickTitle}</h2>
			<ol class="steps">
				{
					s.quick.map((q, i) => (
						<li>
							<a class="card step reveal" href={href(lang, `/docs/${q.slug}/`)}>
								<span class="num">{i + 1}</span>
								<span>
									<h3>{q.t}</h3>
									<p>{q.d}</p>
								</span>
							</a>
						</li>
					))
				}
			</ol>
			<a class="new reveal" href={href(lang, "/docs/cloud/")}>
				<span class="tag">{s.newTitle}</span>
				<span class="txt">{s.newText}</span>
				<span class="go">{s.newLink} →</span>
			</a>
		</div>
		{
			groups.map(({ g, items }) => (
				<div class="grp">
					<h2>{g}</h2>
					<div class="grid">
						{items.map((d) => (
							<a class="card reveal" href={href(lang, `/docs/${d.id.replace(`${lang}/`, "")}/`)}>
								<span class="ico">
									<Icon name={icons[d.data.order - 1] ?? "book"} size={20} />
								</span>
								<h3>{d.data.title}</h3>
								<p>{d.data.description}</p>
							</a>
						))}
					</div>
				</div>
			))
		}
		<a class="more" href={`${REPO}/tree/main/docs`} rel="noopener"><Icon name="github" size={18} />{s.edit}<Icon name="external" size={14} /></a>
	</section>
</Base>

<style>
	.head {
		position: relative;
		padding: 150px 0 40px;
		overflow: hidden;
	}
	.head .wrap {
		display: grid;
		gap: 16px;
		position: relative;
	}
	.body {
		display: grid;
		gap: 48px;
		padding-bottom: 80px;
	}
	h2 {
		font-family: var(--mono);
		font-size: 12.5px;
		text-transform: uppercase;
		letter-spacing: 0.14em;
		color: var(--lavender);
		font-weight: 500;
		margin-bottom: 16px;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 14px;
	}
	.card {
		display: grid;
		gap: 10px;
		align-content: start;
	}
	.card:hover {
		transform: translateY(-3px);
	}
	.ico {
		display: grid;
		place-items: center;
		width: 40px;
		height: 40px;
		border-radius: 12px;
		color: var(--lavender);
		background: rgb(139 92 246 / 0.14);
		border: 1px solid var(--line);
	}
	h3 {
		font-size: 18px;
	}
	.card p {
		color: var(--muted);
		font-size: 14.5px;
	}
	.steps {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 14px;
	}
	.step {
		display: flex;
		gap: 16px;
		align-items: flex-start;
		height: 100%;
	}
	.step:hover {
		transform: translateY(-3px);
	}
	.num {
		flex: none;
		display: grid;
		place-items: center;
		width: 34px;
		height: 34px;
		border-radius: 50%;
		font-weight: 700;
		color: var(--text);
		background: linear-gradient(135deg, #7c3aed, #a855f7);
	}
	.step p {
		color: var(--muted);
		font-size: 14.5px;
		margin-top: 4px;
	}
	.new {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 10px 16px;
		margin-top: 14px;
		padding: 14px 18px;
		border-radius: 14px;
		border: 1px solid var(--line);
		background: rgb(139 92 246 / 0.08);
		font-size: 15px;
	}
	.new:hover {
		background: rgb(139 92 246 / 0.14);
	}
	.tag {
		font-family: var(--mono);
		font-size: 11.5px;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		padding: 4px 10px;
		border-radius: 999px;
		color: var(--text);
		background: rgb(139 92 246 / 0.3);
	}
	.txt {
		flex: 1 1 280px;
		color: var(--muted);
	}
	.go {
		color: var(--lavender);
		white-space: nowrap;
	}
	.more {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		color: var(--lavender);
		justify-self: start;
	}
	@media (max-width: 900px) {
		.steps {
			grid-template-columns: 1fr;
		}
		.grid {
			grid-template-columns: 1fr 1fr;
		}
	}
	@media (max-width: 560px) {
		.grid {
			grid-template-columns: 1fr;
		}
	}
</style>
