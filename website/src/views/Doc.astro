---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";
import { t, href, type Lang, REPO } from "../i18n/strings";

interface Props {
	lang: Lang;
	entry: CollectionEntry<"docs">;
}
const { lang, entry } = Astro.props;
const s = t[lang].docs;
const all = (await getCollection("docs", (d) => d.id.startsWith(`${lang}/`))).sort((a, b) => a.data.order - b.data.order);
const slugOf = (d: CollectionEntry<"docs">) => d.id.replace(`${lang}/`, "");
const groups = [...new Set(all.map((d) => d.data.group))].map((g) => ({ g, items: all.filter((d) => d.data.group === g) }));
const idx = all.findIndex((d) => d.id === entry.id);
const prev = all[idx - 1];
const next = all[idx + 1];
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const current = slugOf(entry);
---

<Base lang={lang} title={entry.data.title} description={entry.data.description}>
	<div class="wrap docs">
		<aside class="side">
			<details open class="sidenav">
				<summary>{s.title}</summary>
				<input type="search" placeholder={s.search} aria-label={s.search} data-filter />
				{
					groups.map(({ g, items }) => (
						<div class="grp">
							<h4>{g}</h4>
							<ul>
								{items.map((d) => (
									<li>
										<a href={href(lang, `/docs/${slugOf(d)}/`)} class:list={[{ on: slugOf(d) === current }]} aria-current={slugOf(d) === current ? "page" : undefined}>
											{d.data.title}
										</a>
									</li>
								))}
							</ul>
						</div>
					))
				}
			</details>
		</aside>

		<article class="main">
			<header>
				<span class="eyebrow">{entry.data.group}</span>
				<h1 class="h-lg">{entry.data.title}</h1>
				<p class="lead">{entry.data.description}</p>
			</header>
			<div class="prose"><Content /></div>
			<nav class="pager">
				{
					prev ? (
						<a href={href(lang, `/docs/${slugOf(prev)}/`)} class="card">
							<small>← {s.prev}</small>
							<span>{prev.data.title}</span>
						</a>
					) : (
						<span />
					)
				}
				{
					next && (
						<a href={href(lang, `/docs/${slugOf(next)}/`)} class="card nx">
							<small>{s.next} →</small>
							<span>{next.data.title}</span>
						</a>
					)
				}
			</nav>
		</article>

		<aside class="toc">
			{
				toc.length > 0 && (
					<>
						<h4>{s.onThisPage}</h4>
						<ul>
							{toc.map((h) => (
								<li class={`d${h.depth}`}>
									<a href={`#${h.slug}`}>{h.text}</a>
								</li>
							))}
						</ul>
					</>
				)
			}
			<a class="gh" href={`${REPO}/tree/main/docs`} rel="noopener"><Icon name="github" size={16} />{s.edit}</a>
		</aside>
	</div>
</Base>

<script>
	const input = document.querySelector<HTMLInputElement>("[data-filter]");
	input?.addEventListener("input", () => {
		const q = input.value.trim().toLowerCase();
		document.querySelectorAll<HTMLElement>(".sidenav li").forEach((li) => {
			li.hidden = !!q && !li.textContent!.toLowerCase().includes(q);
		});
	});
	// Highlight the heading in view.
	const links = new Map<string, HTMLAnchorElement>();
	document.querySelectorAll<HTMLAnchorElement>(".toc a[href^='#']").forEach((a) => links.set(a.hash.slice(1), a));
	const obs = new IntersectionObserver(
		(entries) => {
			for (const e of entries) {
				if (!e.isIntersecting) continue;
				links.forEach((a) => a.classList.remove("on"));
				links.get(e.target.id)?.classList.add("on");
			}
		},
		{ rootMargin: "-90px 0px -70% 0px" },
	);
	document.querySelectorAll(".prose h2[id], .prose h3[id]").forEach((h) => obs.observe(h));
	if (matchMedia("(max-width: 960px)").matches) document.querySelector(".sidenav")?.removeAttribute("open");
</script>

<style>
	.docs {
		display: grid;
		grid-template-columns: 240px minmax(0, 1fr) 220px;
		gap: 48px;
		padding-top: 112px;
		padding-bottom: 60px;
	}
	.side,
	.toc {
		position: sticky;
		top: 96px;
		align-self: start;
		max-height: calc(100vh - 110px);
		overflow-y: auto;
	}
	summary {
		display: none;
	}
	input {
		width: 100%;
		height: 38px;
		padding: 0 12px;
		margin-bottom: 18px;
		border-radius: 10px;
		border: 1px solid var(--line);
		background: var(--surface);
		color: var(--text);
		font: inherit;
		font-size: 14px;
	}
	.grp + .grp {
		margin-top: 20px;
	}
	h4 {
		font-family: var(--mono);
		font-size: 11.5px;
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		color: var(--dim);
		margin-bottom: 8px;
	}
	ul {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 2px;
	}
	.side a {
		display: block;
		padding: 7px 12px;
		border-radius: 9px;
		color: var(--muted);
		font-size: 14.5px;
		border-left: 2px solid transparent;
	}
	.side a:hover {
		color: var(--text);
		background: rgb(139 92 246 / 0.07);
	}
	.side a.on {
		color: var(--text);
		background: rgb(139 92 246 / 0.14);
		border-left-color: var(--violet);
	}
	.main header {
		display: grid;
		gap: 14px;
		padding-bottom: 28px;
		margin-bottom: 8px;
		border-bottom: 1px solid var(--line);
	}
	.main h1 {
		font-size: clamp(32px, 4vw, 46px);
	}
	.pager {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 14px;
		margin-top: 56px;
	}
	.pager .card {
		display: grid;
		gap: 4px;
		padding: 18px 20px;
	}
	.pager .nx {
		text-align: right;
	}
	.pager small {
		color: var(--dim);
	}
	.toc ul {
		gap: 0;
		border-left: 1px solid var(--line);
	}
	.toc a {
		display: block;
		padding: 5px 0 5px 14px;
		font-size: 13.5px;
		color: var(--dim);
		margin-left: -1px;
		border-left: 1px solid transparent;
		transition: color 0.2s;
	}
	.toc .d3 a {
		padding-left: 26px;
	}
	.toc a:hover,
	.toc a.on {
		color: var(--text);
	}
	.toc a.on {
		border-left-color: var(--violet);
	}
	.gh {
		display: inline-flex !important;
		align-items: center;
		gap: 8px;
		margin-top: 24px;
		font-size: 13px;
		color: var(--lavender) !important;
		padding: 0 !important;
		border: 0 !important;
	}
	@media (max-width: 1180px) {
		.docs {
			grid-template-columns: 220px minmax(0, 1fr);
		}
		.toc {
			display: none;
		}
	}
	@media (max-width: 960px) {
		.docs {
			grid-template-columns: 1fr;
			gap: 20px;
			padding-top: 96px;
		}
		.side {
			position: static;
			max-height: none;
		}
		summary {
			display: block;
			cursor: pointer;
			padding: 12px 16px;
			border-radius: 12px;
			border: 1px solid var(--line);
			background: var(--surface);
			margin-bottom: 14px;
			font-weight: 600;
		}
		.pager {
			grid-template-columns: 1fr;
		}
	}
</style>
