---
import { existsSync } from "node:fs";
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import AdapterIcon from "../components/AdapterIcon.astro";
import { type Lang, DISCORD, href } from "../i18n/strings";
import { catalog, adapterText, platformLabel, REGISTRY } from "../i18n/adapters";
import { adapterCopy, categoryLabel } from "../i18n/adapter-copy";

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const s = adapterCopy[lang];
const { adapters, sequence } = await catalog();
const categories = [...new Set(adapters.flatMap((adapter) => adapter.categories))]
	.sort((a, b) => categoryLabel(a, lang).localeCompare(categoryLabel(b, lang), lang));
const resultCount = (adapters.length === 1 ? s.oneResult : s.manyResults).replace("{count}", String(adapters.length));
const shotSizes: Record<string, [number, number]> = { store: [795, 300], details: [540, 510], form: [540, 470] };
const screenshots = Object.entries(s.screenshots).flatMap(([name, copy]) => {
	const path = `/img/adapters/${name}-${lang}.webp`;
	const [width, height] = shotSizes[name] ?? [795, 600];
	return existsSync(`public${path}`) ? [{ path, width, height, ...copy }] : [];
});
---

<Base lang={lang} title={s.title} description={s.lead}>
	<section class="head">
		<div class="wrap">
			{sequence > 0 && (
				<a class="index" href={`${REGISTRY}/releases/latest`} rel="noopener">
					{s.index} #{sequence} <Icon name="external" size={13} />
				</a>
			)}
			<h1 class="h-lg">{s.title}</h1>
			<p class="lead">{s.lead}</p>
		</div>
	</section>

	<div class="wrap catalog" data-adapter-catalog>
		{adapters.length ? (
			<>
				<div class="filters" data-filters hidden>
					<div class="search-field">
						<label for="adapter-search">{s.search}</label>
						<input id="adapter-search" type="search" placeholder={s.searchHint} autocomplete="off" />
					</div>
					<fieldset>
						<legend>{s.categories}</legend>
						<div class="chips">
							<label><input type="radio" name="adapter-category" value="" checked /><span>{s.all}</span></label>
							{categories.map((category) => (
								<label>
									<input type="radio" name="adapter-category" value={category} />
									<span>{categoryLabel(category, lang)}</span>
								</label>
							))}
						</div>
					</fieldset>
				</div>
				<p class="result-count" aria-live="polite" aria-atomic="true" data-result-count data-one={s.oneResult} data-many={s.manyResults}>{resultCount}</p>
				<p class="card message" data-no-matches hidden>{s.noMatches}</p>
				<div class="catalog-grid">
					{adapters.map((adapter) => {
						const { summary, description } = adapterText(adapter, lang);
						const p = adapter.permissions ?? {};
						const permissions = [
							p.read?.length ? s.fileAccess : "",
							p.network?.length ? p.network.join(", ") : s.offline,
							p.secrets?.length ? s.secretAccess : "",
							p.tools?.length ? s.toolAccess : "",
						].filter(Boolean);
						const searchText = [adapter.id, adapter.name, adapter.author, summary, description, ...adapter.categories.map((c) => categoryLabel(c, lang))].join(" ");
						return (
							<article class="card adapter" data-adapter data-search={searchText} data-categories={JSON.stringify(adapter.categories)}>
								<header>
									<AdapterIcon data={adapter.iconData} size={52} />
									<div class="identity">
										<h2>{adapter.name}</h2>
										<p class="meta">v{adapter.version} · {adapter.author}</p>
									</div>
									<span class="pill trust">{s.trust[adapter.trust].label}</span>
								</header>
								<p class="summary">{summary}</p>
								<p class="meta">{adapter.platforms.map(platformLabel).join(" · ")}</p>
								<p class="permission-line"><Icon name="shield" size={16} /> <span>{permissions.join(" · ")}</span></p>
								<a class="btn btn-sm detail" href={href(lang, `/adapters/${adapter.id}/`)} aria-label={`${s.details} (${adapter.name})`}>
									{s.details} <Icon name="arrow" size={16} />
								</a>
							</article>
						);
					})}
				</div>
			</>
		) : <p class="card message">{s.empty}</p>}
	</div>

	{screenshots.length > 0 && (
		<section class="wrap screenshots" aria-labelledby="adapter-screenshots">
			<h2 class="h-md" id="adapter-screenshots">{s.looks}</h2>
			<div class="shots">
				{screenshots.map(({ path, width, height, alt, caption }) => (
					<figure>
						<a href={path}><img src={path} alt={alt} width={width} height={height} loading="lazy" decoding="async" /></a>
						<figcaption>{caption}</figcaption>
					</figure>
				))}
			</div>
		</section>
	)}

	<div class="wrap two">
		<section class="card notes">
			<h2 class="h-md"><Icon name="shield" size={22} /> {s.howTitle}</h2>
			<ul>{s.how.map((line) => <li>{line}</li>)}</ul>
		</section>
		<section class="card notes">
			<h2 class="h-md"><Icon name="code" size={22} /> {s.publishTitle}</h2>
			<p>{s.publish}</p>
			<a class="index" href={`${REGISTRY}/blob/main/CONTRIBUTING.md`} rel="noopener">{s.guide} <Icon name="external" size={13} /></a>
			<p><a class="index" href={DISCORD} rel="noopener">{s.news}</a></p>
		</section>
	</div>
</Base>

<script>
	const catalog = document.querySelector<HTMLElement>("[data-adapter-catalog]");
	const filters = catalog?.querySelector<HTMLElement>("[data-filters]");
	const search = filters?.querySelector<HTMLInputElement>("#adapter-search");
	const count = catalog?.querySelector<HTMLElement>("[data-result-count]");
	const empty = catalog?.querySelector<HTMLElement>("[data-no-matches]");

	if (catalog && filters && search && count && empty) {
		const normalize = (text: string) => text.normalize("NFD").replace(/\p{M}/gu, "").toLowerCase();
		const cards = Array.from(catalog.querySelectorAll<HTMLElement>("[data-adapter]"), (card) => ({
			card,
			text: normalize(card.dataset.search ?? ""),
			categories: JSON.parse(card.dataset.categories ?? "[]") as string[],
		}));

		const applyFilters = () => {
			const terms = normalize(search.value).trim().split(/\s+/);
			const category = filters.querySelector<HTMLInputElement>("input[name=adapter-category]:checked")?.value;
			let visible = 0;
			for (const { card, text, categories } of cards) {
				const matches = terms.every((term) => text.includes(term)) && (!category || categories.includes(category));
				card.hidden = !matches;
				if (matches) visible++;
			}
			const template = visible === 1 ? count.dataset.one : count.dataset.many;
			count.textContent = template?.replace("{count}", String(visible)) ?? "";
			empty.hidden = visible > 0;
		};

		search.addEventListener("input", applyFilters);
		filters.addEventListener("change", applyFilters);
		applyFilters();
		filters.hidden = false;
	}
</script>

<style>
	.head {
		padding: clamp(106px, 12vw, 158px) 0 42px;
		background: radial-gradient(ellipse at 20% 0%, rgb(109 40 217 / 0.24), transparent 72%);
	}
	.head .wrap { display: grid; gap: 12px; justify-items: start; }
	.index {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		color: var(--lavender);
		font-size: 14px;
		text-decoration: underline;
		text-underline-offset: 4px;
	}
	.catalog [hidden] { display: none; }
	.filters {
		display: flex;
		flex-wrap: wrap;
		align-items: end;
		gap: 16px 32px;
		border-block: 1px solid var(--line);
		padding-block: 16px;
	}
	.search-field { flex: 1 1 285px; display: grid; gap: 6px; min-width: 0; }
	.search-field label, legend { color: var(--muted); font-size: 14px; font-weight: 600; }
	input[type="search"] {
		width: 100%;
		min-height: 44px;
		padding: 8px 14px;
		border-radius: var(--radius-sm);
		border: 1px solid var(--line-strong);
		background: var(--bg-2);
		color: var(--text);
		font: inherit;
		font-size: 15px;
	}
	input::placeholder { color: var(--muted); opacity: 1; }
	fieldset { min-inline-size: 0; margin: 0; padding: 0; border: 0; }
	legend { margin-bottom: 6px; padding: 0; }
	.chips { display: flex; flex-wrap: wrap; gap: 8px; }
	.chips label { position: relative; cursor: pointer; }
	.chips input { position: absolute; width: 1px; height: 1px; opacity: 0; }
	.chips span {
		display: block;
		padding: 8px 16px;
		border: 1px solid var(--line-strong);
		border-radius: 999px;
		color: var(--muted);
		font-size: 15px;
	}
	.chips input:checked + span { background: var(--surface-2); color: var(--text); border-color: var(--lavender); }
	.chips input:focus-visible + span { outline: 2px solid var(--lavender); outline-offset: 3px; }
	.result-count { margin: 14px 0; color: var(--muted); font-size: 14px; }
	.catalog-grid, .two {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 16px;
	}
	.adapter {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 10px;
		overflow-wrap: anywhere;
	}
	.adapter header { display: flex; align-items: center; flex-wrap: wrap; gap: 10px 14px; width: 100%; }
	.identity { flex: 1 1 130px; min-width: 0; }
	.adapter h2 { font-size: 23px; margin-bottom: 3px; }
	.trust { padding: 3px 10px; }
	.meta, .permission-line, .message { font-size: 14px; color: var(--muted); }
	.summary {
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		overflow: hidden;
		margin-block: 3px;
	}
	.permission-line { display: flex; gap: 7px; align-items: start; margin-bottom: 4px; }
	.permission-line :global(svg) { flex: none; margin-top: 4px; color: var(--lavender); }
	.detail { margin-top: auto; }
	.screenshots, .two { margin-top: clamp(40px, 7vw, 80px); }
	.shots {
		display: grid;
		align-items: start;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 20px;
		margin-top: 20px;
	}
	figure { margin: 0; }
	figure a { display: block; border: 1px solid var(--line-strong); border-radius: var(--radius-sm); overflow: hidden; }
	figure img { width: 100%; height: auto; }
	figcaption { padding-top: 8px; color: var(--muted); font-size: 14px; }
	.notes { display: grid; gap: 14px; align-content: start; justify-items: start; }
	.notes h2 { display: flex; align-items: center; gap: 10px; }
	.notes h2 :global(svg) { flex: none; color: var(--lavender); }
	.notes p, .notes ul { color: var(--muted); }
	.notes ul { margin: 0; padding-left: 1.2em; }
	.notes li + li { margin-top: 6px; }
	@media (max-width: 690px) {
		.catalog-grid, .two, .shots { grid-template-columns: minmax(0, 1fr); }
		.adapter, .notes { padding: 20px; }
	}
</style>
