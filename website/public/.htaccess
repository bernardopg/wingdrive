# Hostinger (LiteSpeed/Apache) settings for the static WingDrive site.
Options -Indexes
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
	RewriteEngine On
	# Force HTTPS and the bare domain.
	RewriteCond %{HTTPS} off [OR]
	RewriteCond %{HTTP_HOST} ^www\. [NC]
	RewriteRule ^ https://wingdrive.org%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_headers.c>
	Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
	Header always set X-Content-Type-Options "nosniff"
	Header always set Referrer-Policy "strict-origin-when-cross-origin"
	Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
	Header always set X-Frame-Options "SAMEORIGIN"
	<FilesMatch "\.(avif|webp|png|svg|woff2?|webm|mp4)$">
		Header set Cache-Control "public, max-age=2592000"
	</FilesMatch>
	<FilesMatch "^_astro/">
		Header set Cache-Control "public, max-age=31536000, immutable"
	</FilesMatch>
	<FilesMatch "\.html$">
		Header set Cache-Control "public, max-age=0, must-revalidate"
	</FilesMatch>
</IfModule>

<IfModule mod_expires.c>
	ExpiresActive On
	ExpiresByType text/css "access plus 1 year"
	ExpiresByType application/javascript "access plus 1 year"
	ExpiresByType image/avif "access plus 30 days"
	ExpiresByType image/webp "access plus 30 days"
	ExpiresByType video/webm "access plus 30 days"
	ExpiresByType video/mp4 "access plus 30 days"
</IfModule>

<IfModule mod_deflate.c>
	AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json text/xml application/xml
</IfModule>

AddType image/avif .avif
AddType video/webm .webm
AddType application/manifest+json .webmanifest
