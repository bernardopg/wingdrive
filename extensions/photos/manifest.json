{
	"id": "com.wingdrive.photos",
	"name": "Photos",
	"version": "1.0.0",
	"description": "Photo management with metadata extraction and local organization",
	"author": "WingDrive",
	"wasm_file": "photos.wasm",
	"min_core_version": "2.0.0",
	"required_features": ["exif_extraction", "semantic_search"],
	"permissions": {
		"read_entries": {
			"glob": "**/*.{jpg,jpeg,png,heic,heif,raw,cr2,nef,dng,webp}"
		},
		"read_sidecars": ["exif", "thumbnail"],
		"write_sidecars": ["places", "aesthetics"],
		"write_tags": true,
		"write_custom_fields": ["photos"],
		"dispatch_jobs": true,
		"use_models": []
	},
	"models": []
}
