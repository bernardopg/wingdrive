{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"noEmit": true,
		"skipLibCheck": true,
		"jsx": "react-jsx",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"target": "ES2022",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"paths": {
			"~/*": ["./src/*"],
			"@spacebot/api-client": [
				"../../../spacebot/packages/api-client/src/index.ts",
				"../../apps/tauri/src/stubs/spacebot-api-client.ts"
			],
			"@spacebot/api-client/*": [
				"../../../spacebot/packages/api-client/src/*",
				"../../apps/tauri/src/stubs/spacebot-api-client.ts"
			]
		},
		"types": ["@react-three/fiber"]
	},
	"include": ["src"],
	// Bun runs the tests; they import bun:test, which has no type package here.
	"exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
