{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"noEmit": true,
		"jsx": "react-jsx",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"target": "ES2022",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"paths": {
			"~/*": ["./src/*"],
			"@spacebot/api-client": [
				"../../../spacebot/packages/api-client/src/index.ts",
				"../../../apps/tauri/node_modules/@spacebot/api-client-stub/index.d.ts"
			],
			"@spacebot/api-client/*": [
				"../../../spacebot/packages/api-client/src/*",
				"../../../apps/tauri/node_modules/@spacebot/api-client-stub/*"
			]
		},
		"types": ["@react-three/fiber"]
	},
	"include": ["src", "src/vite-env.d.ts"]
}
