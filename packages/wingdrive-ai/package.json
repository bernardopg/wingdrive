{
  "name": "@wingdrive/ai",
  "version": "0.2.5",
  "description": "AI agent interaction components for WingDrive",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap",
    "dev": "tsup src/index.ts --format esm --dts --sourcemap --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@wingdrive/primitives": "^0.2.0",
    "clsx": "^2.1.1",
    "framer-motion": "^13.5.1",
    "react-loader-spinner": "^8.0.2",
    "react-markdown": "^9.1.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-virtual": "^3.13.26",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@tanstack/react-virtual": "^3.14.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "optionalDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@react-sigma/core": "^4.0.3",
    "graphology": "^0.26.0",
    "sigma": "^3.0.3"
  }
}
